{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Cross Compile And Install To OrangePi",
            "group": "build",
            "detail": "交叉 Release 构建",
            "dependsOn": [
                "Release Cross Compile",
                "Scp To Cross Target"
            ],
            "dependsOrder": "sequence",
            "icon": {
                "color": "terminal.ansiGreen",
                "id": "run"
            },
        },
        {
            "type": "shell",
            "label": "Release Cross Compile",
            "group": "build",
            "detail": "交叉 Release 构建",
            "command": "xmake uninstall ; xmake clean -a  && xmake f -m cross && xmake -j15 -v && xmake install",
            "icon": {
                "color": "terminal.ansiGreen",
                "id": "run"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "type": "shell",
            "label": "Scp To Cross Target",
            "group": "build",
            "detail": "Scp 交叉构建产物到目标设备",
            "command": "scp -r ${workspaceFolder}/.vscode/bin/cross/Orangepi.so orangepi@orangepi5B:/home/orangepi/bs/OrganPi/bin",
            "icon": {
                "color": "terminal.ansiGreen",
                "id": "run"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "type": "shell",
            "label": "Compile_Commands",
            "group": "build",
            "detail": "生成compile_commands.json",
            "command": "xmake project -k compile_commands .vscode ",
            "icon": {
                "color": "terminal.ansiGreen",
                "id": "run"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}