{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Debug Compile",
            "group": "build",
            "detail": "Debug 编译",
            "command": "xmake clean -a && xmake f -m debug && xmake build -j15 -v App",
            "args": [],
            "icon": {
                "color": "terminal.ansiGreen",
                "id": "run"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "type": "shell",
            "label": "Release Compile And Run",
            "group": "build",
            "detail": "Release 构建",
            "command": "xmake clean -a && xmake f -m release && xmake -j15 -v && xmake run App 0",
            "icon": {
                "color": "terminal.ansiGreen",
                "id": "run"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "type": "shell",
            "label": "Compile_Commands",
            "group": "build",
            "detail": "生成compile_commands.json",
            "command": "xmake project -k compile_commands .vscode",
            "icon": {
                "color": "terminal.ansiGreen",
                "id": "run"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}